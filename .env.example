# =============================================
# ROM FINDER BOT — Environment Configuration
# =============================================

# --- Telegram ---
BOT_TOKEN=your_bot_token_from_botfather

# --- Admin ---
# Comma-separated Telegram user IDs (get yours from @userinfobot)
ADMIN_IDS=123456789,987654321

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/romfinder?retryWrites=true&w=majority

# --- Channels ---
# Comma-separated channel IDs (must start with -100)
# Get a channel ID by forwarding a message to @userinfobot
CHANNELS=-1001234567890,-1009876543210

# --- Bot Settings ---
MAX_RESULTS=10       # Max search results returned
CACHE_MAX_SIZE=200   # Max in-memory cached queries
CACHE_TTL=3600       # Cache TTL in seconds (1 hour)
NODE_ENV=production

# --- Owner Info (shown in /about) ---
OWNER_NAME=Your Name
OWNER_HANDLE=yourtelegramusername    # WITHOUT the @ symbol
SOURCE_CODE_URL=https://github.com/yourusername/rom-finder-bot
