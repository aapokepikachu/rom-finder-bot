# =============================================
# ROM FINDER BOT - Environment Configuration
# =============================================

# --- Telegram ---
BOT_TOKEN=your_bot_token_from_botfather

# --- Admin ---
# Comma-separated list of Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/romfinder?retryWrites=true&w=majority

# --- Channels ---
# Comma-separated list of channel IDs (must start with -100)
CHANNELS=-1001234567890,-1009876543210,-1001122334455

# --- Bot Settings ---
# Max number of search results to return (default: 10)
MAX_RESULTS=10
# Max cache entries (default: 200)
CACHE_MAX_SIZE=200
# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600
# Node environment
NODE_ENV=production

# --- Owner Info (for /about command) ---
OWNER_USERNAME=@yourhandle
OWNER_NAME=Your Name
